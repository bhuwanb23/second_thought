# --- PayPal sandbox (never commit real values) -------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- AI ---------------------------------------------------------------------
# Without a key the app runs a scripted mock on the identical code path and the
# UI badge reads AI · LLM-MOCK. Set these before recording the demo.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint works:
# LLM_BASE_URL=https://api.openai.com/v1

# --- operator diagnostics ---------------------------------------------------
# Gates /diagnostics. Without it the endpoint returns 404. Public /healthz
# returns two booleans only and never needs this.
DIAG_TOKEN=

# --- approval tokens --------------------------------------------------------
# Signs the human-approval token bound to (tool, arguments).
# MANDATORY in any deployment: a shipped default secret means anyone who has read
# this file can mint an approval token. /healthz reports whether this came from the
# environment ("env") or the default ("default") — a deployment must report "env".
APPROVAL_SECRET=dev-only-change-me
