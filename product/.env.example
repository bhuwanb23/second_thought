# Second Thought — every variable the product reads.
# The code reads nothing else: scripts/v0_check.py fails if a stray
# os.environ read appears outside secondthought/config.py.
#
# Copy to .env and fill in. NEVER commit .env.

# --- PayPal sandbox ---------------------------------------------------------
# From developer.paypal.com → Apps & Credentials, with the toggle on SANDBOX.
# A sandbox client id commonly contains "sb" or begins "AX"; the checker calls
# the real OAuth endpoint rather than trusting the shape.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set once the webhook is registered against a public URL (P5.6). Empty is fine
# until then.
PAYPAL_WEBHOOK_ID=
# sandbox | live — live is refused at runtime by design.
PAYPAL_ENV=sandbox

# --- AI ---------------------------------------------------------------------
# Any OpenAI-compatible endpoint. Without a key the badge reads AI · LLM-MOCK.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
# In-process backstop. The provider-side spend cap is the real protection.
LLM_DAILY_CALL_BUDGET=1500

# --- security ---------------------------------------------------------------
# Signs approval tokens. A shipped default is not a secret; /diagnostics
# reports which one is in use.
APPROVAL_SECRET=
# Gates /diagnostics. Unset means the endpoint returns 404.
DIAG_TOKEN=

# --- verification tooling ---------------------------------------------------
# Only read by scripts/v0_check.py (V0 gate): proves the Render service is on a
# paid Starter plan rather than Free. Never read by the app itself.
RENDER_API_KEY=

# --- runtime ----------------------------------------------------------------
ST_ENV=development
ST_DB_PATH=secondthought.sqlite3
PORT=8000
